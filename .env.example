# Server
PORT=
API_PREFIX=
NODE_ENV=
CORS_ORIGIN=

# Database
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
# Only ever set DB_SYNCHRONIZE=true for quick local prototyping - it will drop/alter
# columns to match entities. Use migrations (npm run migration:run) everywhere else.
DB_SYNCHRONIZE=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Found in Paystack Dashboard > Settings > API Keys & Webhooks. Used to verify
# that incoming /payments/webhook requests genuinely came from Paystack.
PAYSTACK_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Dojah (NIN/BVN identity verification for KYC)
# Get AppId + secret key from your Dojah dashboard. Leave DOJAH_BASE_URL on the
# sandbox host until you have live credentials, then switch to https://api.dojah.io.
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=https://sandbox.dojah.io

# Business rules
# Percentage of an errand's price kept as the platform fee when paying out a runner.
PLATFORM_FEE_PERCENT=

# Redis (OTP codes only - never touches Postgres, expires on its own)
# Get a free instance at upstash.com (Redis > Create Database), then copy the
# "ioredis" / "Redis URL" connection string it gives you - looks like:
# rediss://default:<password>@<region>.upstash.io:6379
REDIS_URL=

# Resend (sends the OTP emails)
# Sign up at resend.com and create an API key under API Keys.
RESEND_API_KEY=
# Without a verified domain on Resend, you can only send to the email you
# signed up with, using the sandbox address below. Verify a domain in the
# Resend dashboard to send to real users.
MAIL_FROM_ADDRESS=Community Errand <onboarding@resend.dev>

# OTP behavior
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
# DEV ONLY - skips Redis/email entirely; codes are kept in memory and logged
# to the server console instead (look for "[OTP BYPASS]"). Refuses to boot if
# NODE_ENV=production. Leave unset/false once REDIS_URL/RESEND_API_KEY are configured.
OTP_BYPASS=

# Admin panel auth (separate from customer JWT_SECRET on purpose - see SETUP.md)
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=4h

# Anthropic (AI Magic Post, price estimates, boost title rewrite, smart replies)
# Get a key at console.anthropic.com
ANTHROPIC_API_KEY=

# VTpass (airtime/data bill purchases from wallet balance)
# Sign up at vtpass.com (use sandbox.vtpass.com for testing). Generate API
# key + public/secret keys under your profile's "API Keys" tab - the public
# and secret keys are shown only once, so copy them immediately.
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PUBLIC_KEY=
# "sandbox" or "live"
VTPASS_ENV=sandbox
